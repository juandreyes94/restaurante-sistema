# Variables de entorno del sistema de pedidos.
#
# En local no hacen falta: alcanza con supabase.config.js y factus.config.js
# (copiados de sus .example). En un servidor esos archivos no existen, así que
# manda lo de aquí.
#
# En Vercel: Project Settings → Environment Variables. Cárgalas en Production
# y en Preview; si no, los despliegues de preview arrancan sin credenciales.

# ── Supabase (obligatorias) ──
# Project Settings → API
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=       # secret: acceso total, se queda en el servidor
SUPABASE_ANON_KEY=               # pública: la usa el navegador para los avisos en vivo

# ── Sesión (obligatoria) ──
# Sin esta, el sistema arranca con un secreto de desarrollo conocido y
# cualquiera podría firmarse un token de administrador. Generar uno así:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ── Factus, facturación electrónica (opcionales) ──
# Si faltan, la facturación se apaga sola y el resto del sistema funciona igual.
FACTUS_EMAIL=
FACTUS_PASSWORD=
FACTUS_NUMBERING_RANGE_ID=1
FACTUS_MUNICIPALITY_ID=149       # 149=Bogotá 276=Medellín 679=Cali 833=Barranquilla
FACTUS_TAX_RATE=0.00             # '0.00' sin IVA · '19.00' con IVA
FACTUS_TRIBUTE_ID=21             # 21=No responsable de IVA · 15=Responsable
